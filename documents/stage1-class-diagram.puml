' Inheritance: toString() is overridden (all other classes inherit Object unchanged)
JObject <|-- GameConfig
JObject <|-- Table
JObject <|-- Customer

' Composition: the whole creates and owns its parts
Restaurant "1" *-- "1..*" Table : tables
Restaurant "1" *-- "1" WaitingQueue : waitingQueue
Menu "1" *-- "3" MenuItem : items

' Associations with multiplicities
Restaurant "1" o-- "0..*" Order : orders
WaitingQueue "0..1" o--- "0..*" Customer : customers
Table "table\n0..1" --- "customer\n0..1" Customer
Customer "customer\n1" -- "order\n0..1" Order
Order "0..*" --> "1" MenuItem : item
Customer "0..*" --> "1" CustomerStatus : status
Order "0..*" --> "1" OrderStatus : status
WaiterChoice "0..*" --> "1" Task : task
WaiterChoice +-- Task

' The controller holds one of each collaborator
TurnController "1" --> "1" Restaurant : restaurant
TurnController "1" --> "1" ArrivalSchedule : arrivalSchedule
TurnController "1" --> "1" Waiter : waiter
TurnController "1" --> "1" Chef : chef
TurnController "1" --> "1" Cashier : cashier
TurnController "1" --> "1" ResultEvaluator : resultEvaluator
TurnController "1" --> "1" ConsoleUI : ui

Waiter "1" --> "1" Menu : menu
Waiter "1" --> "foodChoiceRule\n1" FoodChoiceRule
ConsoleUI "1" --> "1" ResultEvaluator : resultEvaluator

